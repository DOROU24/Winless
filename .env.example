# Скопируйте в .env (в корне проекта) и впишите ключ. Файл .env в git не попадает.
# Его читают и бэкенд при локальном запуске, и docker compose.

# Ключ модели. sk-… — OpenAI, sk-ant-… — Anthropic: провайдер определяется автоматически.
LLM_API_KEY=
# Модель. По умолчанию для OpenAI — gpt-4.1-mini.
LLM_MODEL=gpt-4.1-mini

# Необязательно: явно задать провайдера (openai | anthropic) или свой адрес OpenAI-совместимого API.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
